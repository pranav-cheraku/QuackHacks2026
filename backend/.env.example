# Projektor — backend environment variables
# Copy this file to frontend/.env.local and fill in your values.
# NEVER commit real values to source control.

# Gemini API key — server-side only (no VITE_ prefix → never sent to the browser)
# Get yours at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
